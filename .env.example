# Copy to .env and fill in. .env is git-ignored and must never be committed.
# The application reads credentials only from the environment; no credential
# value ever appears in a configuration file, an event payload, or a
# provenance record.

# The command reads this file into the environment when it starts, so a
# credential put here reaches `serve` without being exported by hand. Three
# rules keep that from becoming a second credential surface: a variable the
# shell already exported wins over the line here; a line with no value leaves
# the variable unset rather than empty; and nothing prints a value, only the
# names it read.
#
# THIS FILE IS COMMITTED. It may carry endpoints, and nothing else. A token
# written here is published, and the only way to un-publish one is to revoke
# it — deleting the line leaves the value in history. Real values go in .env,
# which is git-ignored.

# Zenodo (use the sandbox for development)
DD_ZENODO_BASE=https://sandbox.zenodo.org
DD_ZENODO_TOKEN=

# ORCID OAuth client (identity, not deposit)
DD_ORCID_CLIENT_ID=
DD_ORCID_CLIENT_SECRET=
DD_ORCID_BASE=https://sandbox.orcid.org

# Model backends
DD_OLLAMA_ENDPOINT=http://localhost:11434
DD_ANTHROPIC_API_KEY=
