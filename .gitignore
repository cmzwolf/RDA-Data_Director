# Credentials. Present from the first commit, deliberately.
.env
.env.*
!.env.example
*.token

# Working and state directories
/var/
/state/
/work/

# Deployment-local configuration, made from the examples. The real wiring
# names endpoints and the real policy decides what may leave the machine;
# neither belongs in a published tree.
config/wiring.yaml
config/policy.yaml
local-accounts.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
